---
source: crates/cli/tests/it/linux_dns.rs
expression: observed
---
[
    (
        "conflict",
        RunOutput {
            exit_code: ExitCode(
                unix_exit_status(
                    1,
                ),
            ),
            stdout: "Prepared PV DNS resolver config\n  path: <tempdir>/conflict/.pv/config/resolver/test\n  DNS resolver port: <dns-port>\nSystem resolver config is not PV-owned: /etc/systemd/system/pv-dns.service\n  Leaving it in place.\n",
            stderr: "",
        },
        RunOutput {
            exit_code: ExitCode(
                unix_exit_status(
                    0,
                ),
            ),
            stdout: "Deleted prepared DNS resolver config: <tempdir>/conflict/.pv/config/resolver/test\nRemoved PV-owned system resolver config: /etc/systemd/system/pv-dns.service\n",
            stderr: "",
        },
    ),
    (
        "unreadable",
        RunOutput {
            exit_code: ExitCode(
                unix_exit_status(
                    1,
                ),
            ),
            stdout: "Prepared PV DNS resolver config\n  path: <tempdir>/unreadable/.pv/config/resolver/test\n  DNS resolver port: <other-dns-port>\nSystem resolver config could not be inspected: /etc/systemd/system/pv-dns.service\n  fixture resolved unavailable\n  Leaving it in place.\n",
            stderr: "",
        },
        RunOutput {
            exit_code: ExitCode(
                unix_exit_status(
                    0,
                ),
            ),
            stdout: "Deleted prepared DNS resolver config: <tempdir>/unreadable/.pv/config/resolver/test\nRemoved PV-owned system resolver config: /etc/systemd/system/pv-dns.service\n",
            stderr: "",
        },
    ),
]
