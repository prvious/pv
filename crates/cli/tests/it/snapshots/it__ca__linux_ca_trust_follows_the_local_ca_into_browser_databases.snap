---
source: crates/cli/tests/it/ca.rs
expression: "(before_setup, trusted, browsers_missing, repaired, removed,\nenvironment.operations.borrow().clone(),)"
---
(
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "CA trust status\nLocal CA files: missing\n  certificate: <tempdir>/home/.pv/certificates/ca.pem\n  private key: <tempdir>/home/.pv/certificates/ca-key.pem\nSystem keychain trust: unknown\n  local CA is unavailable\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared PV local CA\n  certificate: <tempdir>/home/.pv/certificates/ca.pem\n  private key: <tempdir>/home/.pv/certificates/ca-key.pem\n  fingerprint: <fingerprint>\nSystem keychain trust: not trusted\n  fingerprint: <fingerprint>\nTrusted PV local CA in the System keychain.\nTrusted PV browser CA: <tempdir>/home/.pki/nssdb\nTrusted PV browser CA: <tempdir>/home/.mozilla/firefox/default\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "CA trust status\nLocal CA files: current\n  certificate: <tempdir>/home/.pv/certificates/ca.pem\n  private key: <tempdir>/home/.pv/certificates/ca-key.pem\n  common name: PV Local Development CA\n  fingerprint: <fingerprint>\nSystem keychain trust: current\n  fingerprint: <fingerprint>\nBrowser CA trust: <tempdir>/home/.pki/nssdb: not trusted\n  fingerprint: <fingerprint>\nBrowser CA trust: <tempdir>/home/.mozilla/firefox/default: not trusted\n  fingerprint: <fingerprint>\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared PV local CA\n  existing local CA is current\nSystem keychain trust: current\n  fingerprint: <fingerprint>\nSystem keychain trust already matches PV.\nTrusted PV browser CA: <tempdir>/home/.pki/nssdb\nTrusted PV browser CA: <tempdir>/home/.mozilla/firefox/default\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared PV local CA trust removal\nLocal CA files: current\n  certificate: <tempdir>/home/.pv/certificates/ca.pem\n  private key: <tempdir>/home/.pv/certificates/ca-key.pem\n  common name: PV Local Development CA\n  fingerprint: <fingerprint>\nSystem keychain trust: current\n  fingerprint: <fingerprint>\nRemoved PV local CA trust from the System keychain.\nRemoved PV browser CA trust: <tempdir>/home/.pki/nssdb\nRemoved PV browser CA trust: <tempdir>/home/.mozilla/firefox/default\n",
        stderr: "",
    },
    [
        "trust <fingerprint>",
        "browser-trust <tempdir>/home/.pki/nssdb",
        "browser-trust <tempdir>/home/.mozilla/firefox/default",
        "browser-trust <tempdir>/home/.pki/nssdb",
        "browser-trust <tempdir>/home/.mozilla/firefox/default",
        "untrust <fingerprint>",
        "browser-untrust <tempdir>/home/.pki/nssdb",
        "browser-untrust <tempdir>/home/.mozilla/firefox/default",
    ],
)
