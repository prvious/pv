---
source: crates/cli/tests/linux_dns.rs
expression: "(install, uninstall)"
---
(
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                1,
            ),
        ),
        stdout: "Prepared PV DNS resolver config\n  path: <tempdir>/home/.pv/config/resolver/test\n  DNS resolver port: <dns-port>\nSystem DNS routing conflicts with existing configuration: /etc/systemd/system/pv-dns.service\n  Leaving it in place.\n  Ask an administrator to inspect pv-dns.service and its overrides, pv0 ownership, and other links' ~test routes; remove or rename the conflicting configuration manually before retrying `pv dns:install` or `pv dns:uninstall`.\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                1,
            ),
        ),
        stdout: "Deleted prepared DNS resolver config: <tempdir>/home/.pv/config/resolver/test\nSystem DNS routing conflicts with existing configuration: /etc/systemd/system/pv-dns.service\n  Leaving it in place.\n  Ask an administrator to inspect pv-dns.service and its overrides, pv0 ownership, and other links' ~test routes; remove or rename the conflicting configuration manually before retrying `pv dns:install` or `pv dns:uninstall`.\n",
        stderr: "",
    },
)
