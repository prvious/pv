---
source: crates/cli/tests/ca.rs
expression: "(missing, repaired, repaired_operations, failed, removed)"
---
(
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "CA trust status\nLocal CA files: current\n  certificate: <tempdir>/home/.pv/certificates/ca.pem\n  private key: <tempdir>/home/.pv/certificates/ca-key.pem\n  common name: PV Local Development CA\n  fingerprint: <fingerprint>\nSystem CA trust: current\nBrowser CA trust: <tempdir>/home/.pki/nssdb · not trusted\nBrowser CA trust: <tempdir>/home/.mozilla/firefox/default · not trusted\n",
        stderr: "",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared PV local CA\nPV local CA is trusted in the system store\nBrowser CA trust: <tempdir>/home/.pki/nssdb · current\nBrowser CA trust: <tempdir>/home/.mozilla/firefox/default · current\n",
        stderr: "",
    },
    [
        "browser-trust <tempdir>/home/.pki/nssdb",
        "browser-trust <tempdir>/home/.mozilla/firefox/default",
    ],
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                1,
            ),
        ),
        stdout: "Prepared PV local CA\nPV local CA is trusted in the system store\nBrowser CA trust: <tempdir>/home/.pki/nssdb · current\n",
        stderr: "error: system integration operation failed: fixture browser failure\n",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Removed PV browser CA trust: <tempdir>/home/.pki/nssdb\nRemoved PV browser CA trust: <tempdir>/home/.mozilla/firefox/default\nPV local CA trust is absent from the system and browser stores\n",
        stderr: "",
    },
)
