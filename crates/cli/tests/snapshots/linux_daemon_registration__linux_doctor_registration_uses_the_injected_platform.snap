---
source: crates/cli/tests/linux_daemon_registration.rs
expression: checks
---
[
    (
        Macos,
        "missing",
        Object {
            "detail": String("path: <tempdir>/Macos-missing/.config/systemd/user/pv-daemon.service"),
            "message": String("LaunchAgent is missing"),
            "name": String("Daemon LaunchAgent"),
            "repair": String("pv daemon:enable"),
            "status": String("fail"),
        },
    ),
