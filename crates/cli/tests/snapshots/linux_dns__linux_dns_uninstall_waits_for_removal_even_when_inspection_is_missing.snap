---
source: crates/cli/tests/linux_dns.rs
expression: "(first, retry)"
---
(
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                1,
            ),
        ),
        stdout: "Deleted prepared DNS resolver config: <tempdir>/home/.pv/config/resolver/test\n",
        stderr: "error: resolver remove failed: PV privileged helper I/O failed: fixture response lost after request; DNS state may be partial and a queued or in-flight request may still complete; inspect pv-dns.service, pv-dns.service.candidate and pv0 with an administrator before retrying `pv dns:install` or `pv dns:uninstall`\n",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared DNS resolver config already absent: <tempdir>/home/.pv/config/resolver/test\nSystem resolver config already absent: /etc/systemd/system/pv-dns.service\n",
        stderr: "",
    },
)
