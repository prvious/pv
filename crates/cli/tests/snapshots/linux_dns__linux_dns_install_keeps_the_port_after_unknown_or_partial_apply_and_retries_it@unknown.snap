---
source: crates/cli/tests/linux_dns.rs
expression: "(first, retry)"
---
(
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                1,
            ),
        ),
        stdout: "Prepared PV DNS resolver config\n  path: <tempdir>/unknown/.pv/config/resolver/test\n  DNS resolver port: <dns-port>\nPV daemon is running.\n",
        stderr: "error: resolver apply failed: PV privileged helper I/O failed: fixture response lost after request; DNS state may be partial and a queued or in-flight request may still complete; inspect pv-dns.service, pv-dns.service.candidate and pv0 with an administrator before retrying `pv dns:install` or `pv dns:uninstall`\n",
    },
    RunOutput {
        exit_code: ExitCode(
            unix_exit_status(
                0,
            ),
        ),
        stdout: "Prepared PV DNS resolver config\n  path: <tempdir>/unknown/.pv/config/resolver/test\n  DNS resolver port: <dns-port>\nPV daemon is running.\nInstalled system resolver config: /etc/systemd/system/pv-dns.service\n",
        stderr: "",
    },
)
