---
source: crates/self-update/tests/app_update_manifest.rs
expression: errors
---
[
    (
        "unsupported_schema",
        UnsupportedManifestSchema {
            schema_version: 3,
            supported_schema_version: 2,
        },
    ),
    (
        "preview_channel",
        UnsupportedChannel {
            channel: "preview",
        },
    ),
    (
        "invalid_version",
        InvalidIdentity {
            kind: "version",
            value: "0.02.0",
        },
    ),
    (
        "newer_minimum",
        RequiresNewerPv {
            minimum_pv_version: "999.0.0",
            current_pv_version: "<current-pv-version>",
        },
    ),
]
