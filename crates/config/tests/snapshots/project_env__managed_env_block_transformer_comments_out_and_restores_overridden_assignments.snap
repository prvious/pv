---
source: crates/config/tests/project_env.rs
expression: "vec![(\"commented\", commented), (\"repeated\", repeated),\n(\"key-removed\", key_removed), (\"all-removed\", all_removed),\n(\"block-deleted\", block_deleted),]"
---
[
    (
        "commented",
