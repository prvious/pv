---
source: crates/config/tests/it/project_config.rs
expression: "read_file(&project.join(\"pv.yml\"))?"
---
serve: false
env_file: .env.local
php:
  version: '8.4'
  extensions:
  - redis
  - xdebug
root: public
env:
  APP_URL: ${url}
hooks:
  setup:
  - php artisan migrate
mysql:
  version: '8.0'
  env:
    DB_HOST: ${host}
  allocations:
    app-db:
      env:
        DB_DATABASE: ${database}
postgres:
  version: latest
