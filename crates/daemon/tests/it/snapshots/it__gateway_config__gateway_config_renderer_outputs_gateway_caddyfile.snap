---
source: crates/daemon/tests/it/gateway_config.rs
expression: rendered
---
{
    admin "unix//Users/alice/.pv/run/gateway-admin.sock|0600"
    persist_config off
    log {
        output file "/Users/alice/.pv/logs/gateway/error.log" {
            roll_size 10MiB
            roll_uncompressed
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    storage file_system {
        root "/Users/alice/.pv/certificates/caddy"
    }
    servers {
        protocols h1 h2
    }
    pki {
        ca local {
            root {
                format pem_file
                cert "/Users/alice/.pv/certificates/ca.pem"
                key "/Users/alice/.pv/certificates/ca-key.pem"
            }
        }
    }
}

http://pv-gateway.localhost {
    bind fd/3
    log {
        output file "/Users/alice/.pv/logs/gateway/access.log" {
            roll_size 10MiB
            roll_uncompressed
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    respond /__pv/health "pv-gateway-health-v2" 200
}

https://pv-gateway.localhost {
    bind fd/4
    log {
        output file "/Users/alice/.pv/logs/gateway/access.log" {
            roll_size 10MiB
            roll_uncompressed
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    tls {
        issuer internal {
            ca local
        }
    }
    respond /__pv/health "pv-gateway-health-v2" 200
}

http:// {
    bind fd/3
    log {
        output file "/Users/alice/.pv/logs/gateway/access.log" {
            roll_size 10MiB
            roll_uncompressed
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
    redir https://{host}{uri} 308
}

import "/Users/alice/.pv/config/gateway/projects/*.Caddyfile"
